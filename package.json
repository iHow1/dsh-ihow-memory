{
  "name": "dsh-ihow-memory",
  "version": "0.1.0-alpha.5",
  "description": "Install iHow Memory as a local-first shared memory plugin for DeepSeek Harness.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "iHow Memory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHow1/dsh-ihow-memory.git"
  },
  "homepage": "https://github.com/iHow1/dsh-ihow-memory#readme",
  "bugs": {
    "url": "https://github.com/iHow1/dsh-ihow-memory/issues"
  },
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "ihow-memory",
    "agent-memory",
    "cross-agent-memory"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "lib/",
    "cordis.patch.yml",
    "DEMO.md",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/*.mjs",
    "demo:cross-session": "node scripts/cross-session-demo.mjs",
    "demo:dsh-host": "node scripts/dsh-cross-session-demo.mjs",
    "verify": "npm test && npm run demo:cross-session && node scripts/verify-package.mjs",
    "prepack": "npm run verify"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "ihow-memory": "0.1.0-alpha.34"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2"
  }
}
